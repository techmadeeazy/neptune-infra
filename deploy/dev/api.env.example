# neptune-api settings on the dev server. setup-env.sh copies this to
# api.env and fills every {{...}} with a fresh random value. Values marked
# "you set" are entered by hand on the server and never committed.

NODE_ENV=production
API_PORT=3001
DATABASE_URL=postgresql://neptune_api_role:{{API_DB_PASSWORD}}@host.docker.internal:5432/neptune
REDIS_URL=redis://neptune-redis:6379

JWT_SECRET={{JWT_SECRET}}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
TOTP_ENCRYPTION_KEY={{TOTP_ENCRYPTION_KEY}}
TWO_FACTOR_ISSUER=Neptune Dev

# The proxy container's network, so the client address comes from the
# X-Forwarded-For header nginx sets.
TRUSTED_PROXY_IPS=172.30.0.0/24
CORS_ALLOWED_ORIGINS=https://neptune-web.vercel.app
APP_PUBLIC_URL=https://neptune-web.vercel.app
API_DOCS_ENABLED=true

# Production mode refuses the console SMS provider. You set the Termii key.
SMS_PROVIDER=termii
TERMII_API_KEY=

# Gmail SMTP. You set the user and app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=

SEARCH_ENGINE=meilisearch
MEILISEARCH_URL=http://neptune-meilisearch:7700
MEILISEARCH_KEY={{MEILI_MASTER_KEY}}

# File storage. You set the bucket keys (S3, DigitalOcean Spaces or MinIO).
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_REGION=
S3_UPLOADS_BUCKET=
S3_DOCUMENTS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The two internal keys must match admin.env (setup-env.sh writes both).
ADMIN_INTERNAL_API_URL=http://neptune-proxy:8080/api/internal
ADMIN_INTERNAL_API_KEY={{ADMIN_INTERNAL_API_KEY}}
API_INTERNAL_KEY={{API_INTERNAL_KEY}}
