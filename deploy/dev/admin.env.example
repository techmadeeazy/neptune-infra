# neptune-admin settings on the dev server (the site, the queue worker and
# the scheduler all read this file). setup-env.sh copies it to admin.env and
# fills every {{...}}. Values marked "you set" are entered by hand on the
# server and never committed.

APP_NAME="Neptune Admin (dev)"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL=https://neptune-admin.techmadeeazy.com:7444

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=neptune
DB_USERNAME=neptune_admin_role
DB_PASSWORD={{ADMIN_DB_PASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=neptune-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP. You set the user, app password and the three team mailboxes.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Neptune (dev)"
MAIL_OPERATIONS_ADDRESS=
MAIL_FINANCE_ADDRESS=
MAIL_SUPPORT_ADDRESS=

# File storage. You set the bucket keys; must match api.env.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
UPLOADS_PUBLIC_BASE_URL=

# The two internal keys must match api.env (setup-env.sh writes both).
NODE_API_URL=http://neptune-api:3001/api/internal
NODE_API_KEY={{API_INTERNAL_KEY}}
ADMIN_INTERNAL_API_KEY={{ADMIN_INTERNAL_API_KEY}}

OWNER_INVITATION_URL=https://neptune-web.vercel.app/invitations/accept
ADMIN_CUSTODY_EMAIL=admin-custody@neptune.invalid

# You set the addresses allowed into the console, comma separated. Keep
# nginx/allowlist.conf the same.
ADMIN_IP_ALLOWLIST=
TRUSTED_PROXIES=
